{
  "expo": {
    "name": "Meribaari",
    "slug": "ranjeet23",
    "owner": "ranjeet123s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meribaari",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.patientqueue.gtzdaf",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload doctor photos, ID proof, and degree certificates",
        "NSCameraUsageDescription": "Capture doctor documents for verification",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0369A1"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.patientqueue.gtzdaf",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0369A1"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0369A1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "de55a90d-20cb-4f24-9630-3e214bb5ccf9"
      }
    }
  }
}
