MONGO_URL=mongodb://localhost:27017
DB_NAME=clinicqueue
JWT_SECRET=replace-with-a-long-random-development-secret
DPDP_STRIP_DEV_OTP=0
EMERGENT_PUSH_KEY=placeholder

# SMS Provider Switch: liveair | brevo | renflair
SMS_PROVIDER=liveair

# LiveAir HTTP SMS API Configuration
LIVEAIR_API_TOKEN=your_liveair_api_token
LIVEAIR_SENDER_ID=your_approved_sender_id
LIVEAIR_ROUTE=2
LIVEAIR_MESSAGE_TYPE=1
LIVEAIR_TEMPLATE_ID=your_approved_dlt_template_id
LIVEAIR_BASE_URL=http://godspeed.liveair.co.in/httpapi

# LiveAir Trans OTP Configuration (Requirement 4)
LIVEAIR_OTP_SENDER_ID=your_approved_otp_sender_id
LIVEAIR_OTP_ROUTE=4
LIVEAIR_OTP_MESSAGE_TYPE=1
LIVEAIR_OTP_TEMPLATE_ID=your_approved_otp_dlt_template_id

# Dev Test SMS Endpoint Switch (1 to enable /api/dev/test-sms)
DEV_TEST_SMS_ENABLED=1

# Frontend Public Host for dynamic appointment tracking links
APP_PUBLIC_URL=https://health-at0ltu9id-mariya12.vercel.app

# Existing Brevo credentials
BREVO_API_KEY=your_brevo_api_key
BREVO_SMS_SENDER=Meribaari

# Existing Renflair credentials
RENFLAIR_API_KEY=your_renflair_api_key
RENFLAIR_BASE_URL=https://sms.renflair.in