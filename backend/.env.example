MONGO_URL=mongodb://localhost:27017
DB_NAME=clinicqueue
JWT_SECRET=replace-with-a-long-random-development-secret
DPDP_STRIP_DEV_OTP=0
EMERGENT_PUSH_KEY=placeholder

# Web Push / Firebase Cloud Messaging (FCM) Configuration
# Place service account JSON in one of:
# 1) FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'
# 2) Or individual environment variables:
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=your_firebase_client_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 3) Or place firebase-service-account.json directly in the backend/ directory (gitignored)
QUEUE_ETA_CHANGE_THRESHOLD_MINUTES=10

# Messaging / SMS Provider Switch: aisensy | liveair | brevo | renflair
SMS_PROVIDER=aisensy

# AiSensy WhatsApp API Configuration (https://wiki.aisensy.com/en/articles/11501889-api-reference-docs)
# AISENSY_API_KEY (or Project_api_key in .env)
AISENSY_API_KEY=your_aisensy_project_api_key
# Name of the live API Campaign created in AiSensy for OTP messages (default: meribaari)
AISENSY_OTP_CAMPAIGN_NAME=meribaari
# Name of the live API Campaign created in AiSensy for Appointment Utility messages (intended: Meribaari_appointment_api)
AISENSY_APPT_CAMPAIGN_NAME=Meribaari_appointment_api
# AiSensy API Endpoint (default: https://backend.aisensy.com/campaign/t1/api/v2)
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2

# LiveAir HTTP SMS API Configuration
LIVEAIR_API_TOKEN=your_liveair_api_token
LIVEAIR_SENDER_ID=your_approved_sender_id
LIVEAIR_ROUTE=2
LIVEAIR_MESSAGE_TYPE=1
LIVEAIR_TEMPLATE_ID=your_approved_dlt_template_id
LIVEAIR_BASE_URL=http://godspeed.liveair.co.in/httpapi

# LiveAir Trans OTP Configuration
LIVEAIR_OTP_SENDER_ID=your_approved_otp_sender_id
LIVEAIR_OTP_ROUTE=4
LIVEAIR_OTP_MESSAGE_TYPE=1
LIVEAIR_OTP_TEMPLATE_ID=your_approved_otp_dlt_template_id

# Dev Test SMS Endpoint Switch (1 to enable /api/dev/test-sms)
DEV_TEST_SMS_ENABLED=1

# Frontend Public Host for dynamic appointment tracking links
APP_PUBLIC_URL=https://health-at0ltu9id-mariya12.vercel.app

# Brevo credentials
BREVO_API_KEY=your_brevo_api_key
BREVO_SMS_SENDER=Meribaari

# Renflair credentials
RENFLAIR_API_KEY=your_renflair_api_key
RENFLAIR_BASE_URL=https://sms.renflair.in