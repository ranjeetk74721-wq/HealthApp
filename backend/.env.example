# ==========================================================
# MeriBaari Backend Environment Configuration Template (.env.example)
# Copy this file to `backend/.env` and fill in your secrets.
# ==========================================================

# Database Connection (MongoDB Atlas URI or Local Mongo)
MONGO_URL=mongodb://localhost:27017
DB_NAME=clinicqueue

# Authentication & Security
JWT_SECRET=replace-with-a-long-random-development-secret
DPDP_STRIP_DEV_OTP=0

# Default Seed & Verification Credentials
ADMIN_INITIAL_EMAIL=admin@meribaariapp.in
ADMIN_INITIAL_PASSWORD=ChangeMeInProd@123
ADMIN_INITIAL_HOSPITAL_ID=H00001
DEFAULT_HOSPITAL_PASSWORD=Hospital@123

# Public Application URLs & CORS Configuration
APP_PUBLIC_URL=https://www.meribaariapp.in
ALLOWED_ORIGINS=https://www.meribaariapp.in,https://meribaariapp.in

# Support Contact
SUPPORT_EMAIL=easehealthcareapp@gmail.com
SUPPORT_PHONE=+91 9153719933

# ==========================================================
# Messaging & Notification Provider (AiSensy WhatsApp API)
# ==========================================================
SMS_PROVIDER=aisensy
AISENSY_API_KEY=your_aisensy_project_api_key
AISENSY_OTP_CAMPAIGN_NAME=meribaari
AISENSY_APPT_CAMPAIGN_NAME=Meribaari_appointment_api
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2

# Web Push / Firebase Cloud Messaging (FCM) Configuration (Optional)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=your_firebase_client_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
QUEUE_ETA_CHANGE_THRESHOLD_MINUTES=10

# Development Helpers
DEV_TEST_SMS_ENABLED=0